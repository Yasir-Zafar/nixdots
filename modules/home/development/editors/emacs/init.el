;; Claude Code in a vterm at the project root, one per project (C-c C again jumps back to it).
;; Files it changes reload by themselves (global-auto-revert-mode). nixpkgs' claude-code
;; package is a different, projectile-based one that breaks on Emacs 31, hence this.
(defun my/claude-code ()
  "Open, or switch to, Claude Code for the current project."
  (interactive)
  (let* ((project (project-current))
         (default-directory (if project (project-root project) default-directory))
         (name (format "*claude: %s*"
                       (file-name-nondirectory (directory-file-name default-directory)))))
    (if (get-buffer name)
        (pop-to-buffer name)
      (let ((vterm-shell "claude"))
        (vterm-other-window name)))))
(keymap-global-set "C-c C" #'my/claude-code)

