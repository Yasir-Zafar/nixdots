;;; init.el --- Emacs, configured in ~/dots -*- lexical-binding: t -*-
;; Linked from the repo by modules/home/development/editors/emacs/default.nix.
;; Every package below is installed by Nix (that file's extraPackages); use-package only
;; configures them. Stock Emacs keys plus the usual modern additions; the full key list is in
;; docs/EMACS.md. Sections are outline headings: C-c @ C-t folds, M-g i jumps.

;;; Nix values, PATH, state directories

(add-to-list 'load-path (expand-file-name "lisp" user-emacs-directory))
(require 'nix) ; my/nix-tool-paths, my/font-*: generated by default.nix

;; The daemon starts from systemd, not a login shell: add the home and system profiles, then
;; the language servers/formatters that Nix provides only to Emacs. envrc (below) puts a
;; project's own toolchain in front, per buffer.
(dolist (dir (append (list (expand-file-name "~/.nix-profile/bin")
                           (expand-file-name "~/.local/state/nix/profile/bin")
                           (concat "/etc/profiles/per-user/" user-login-name "/bin")
                           "/run/current-system/sw/bin"
                           "/run/wrappers/bin")
                     my/nix-tool-paths))
  (unless (member dir exec-path)
    (setq exec-path (append exec-path (list dir)))
    (setenv "PATH" (concat (getenv "PATH") path-separator dir))))

;; Nothing comes from package archives: packages are Nix's.
(setq package-archives nil)

(setq use-package-always-defer nil
      use-package-expand-minimally t)

;; Keep ~/.config/emacs (the repo) clean: state in ~/.local/state/emacs.
(setq no-littering-etc-directory (expand-file-name "etc/" my/state-dir)
      no-littering-var-directory (expand-file-name "var/" my/state-dir))
(require 'no-littering)
(no-littering-theme-backups)
(setq custom-file (no-littering-expand-etc-file-name "custom.el"))
(when (file-exists-p custom-file) (load custom-file nil t))

(use-package gcmh
  :config (gcmh-mode 1))

;;; Defaults

(setq-default indent-tabs-mode nil
              tab-width 4
              fill-column 100
              truncate-lines t)
(setq use-short-answers t
      confirm-kill-processes nil
      ring-bell-function #'ignore
      require-final-newline t
      sentence-end-double-space nil
      create-lockfiles nil
      kill-do-not-save-duplicates t
      save-interprogram-paste-before-kill t
      scroll-conservatively 101
      scroll-margin 2
      mouse-wheel-progressive-speed nil
      enable-recursive-minibuffers t
      read-extended-command-predicate #'command-completion-default-include-p
      help-window-select t
      x-stretch-cursor t
      global-auto-revert-non-file-buffers t
      auto-revert-verbose nil
      recentf-max-saved-items 300
      history-length 1000
