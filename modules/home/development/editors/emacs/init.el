;;; Look: gruvbox, fonts, modeline, dashboard

(defun my/fonts ()
  "Set fonts on graphical frames (the daemon has none at startup)."
  (when (display-graphic-p)
    (set-face-attribute 'default nil :family my/font-mono :height my/font-size)
    (set-face-attribute 'fixed-pitch nil :family my/font-mono :height 1.0)
    (set-face-attribute 'variable-pitch nil :family my/font-sans :height 1.05)))
(if (daemonp)
    (add-hook 'server-after-make-frame-hook #'my/fonts)
  (my/fonts))

