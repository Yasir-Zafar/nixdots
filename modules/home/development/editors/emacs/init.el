(delete-selection-mode 1)        ; typing replaces the selection
(global-auto-revert-mode 1)      ; files changed on disk (git, Claude) reload
(savehist-mode 1)                ; minibuffer history across restarts
(save-place-mode 1)              ; reopen files where you left them
(recentf-mode 1)
(column-number-mode 1)
(global-so-long-mode 1)          ; minified one-line files don't freeze Emacs
