# Emacs 31 (pgtk: native wayland), configured end to end with stock Emacs keys.
#
# Nix owns everything that can be installed: Emacs itself, every package (no package.el, no
# downloads at runtime), tree-sitter grammars, language servers, formatters, debug adapters, and
# the daemon. The Lisp is in ./early-init.el and ./init.el, linked into ~/.config/emacs.
# Values Nix knows (tool paths, fonts) reach Lisp through the generated nix.el.
# State (history, recentf, eln cache…) goes to ~/.local/state/emacs, never into the repo.
# Keys and usage: docs/EMACS.md. The old Doom-style setup is ../emacs.nix (not imported).
{
  config,
  pkgs,
  ...
}: let
  # on emacs' exec-path only, so they don't land on the shell's PATH (nixvim does the same).
  # A project's own toolchain (direnv / templates/) still comes first through envrc.
  tools = with pkgs; [
    # language servers (eglot)
    rust-analyzer
    clang-tools # clangd, clang-format
    basedpyright
    typescript-language-server
    typescript
    nil
    lua-language-server
    bash-language-server
    vscode-langservers-extracted # json, css, html
    yaml-language-server
    taplo # toml
    marksman # markdown
    emacs-lsp-booster # eglot-booster: faster json for big servers
    # formatters (apheleia)
    alejandra
    ruff
    prettier
    shfmt
    stylua
    # debugging (dape)
    lldb # lldb-dap: rust, c, c++
    (python3.withPackages (ps: [ps.debugpy]))
    # used by consult, dired, magit
    ripgrep
    fd
    git
  ];

  fonts = config.stylix.fonts;

  nixEl = pkgs.writeText "nix.el" ''
    ;;; nix.el --- values from home-manager -*- lexical-binding: t -*-
    ;; generated by modules/home/development/editors/emacs/default.nix; do not edit
    (defconst my/nix-tool-paths '(${toString (map (p: ''"${p}/bin"'') tools)}))
    (defconst my/font-mono "${fonts.monospace.name}")
    (defconst my/font-sans "${fonts.sansSerif.name}")
    (defconst my/font-size ${toString (fonts.sizes.terminal * 10)})
    (provide 'nix)
  '';
in {
  programs.emacs = {
    enable = true;
    package = pkgs.emacs-pgtk;
    extraPackages = epkgs:
      with epkgs; [
        # look
        doom-themes
        doom-modeline
        nerd-icons
        nerd-icons-completion
        nerd-icons-corfu
        nerd-icons-dired
        dashboard
        rainbow-delimiters
        hl-todo
        breadcrumb
        spacious-padding

        # minibuffer completion: the vertico stack
        vertico
        orderless
        marginalia
        consult
        consult-eglot
        embark
        embark-consult
        wgrep # edit grep results in place

        # in-buffer completion
        corfu
        cape
        yasnippet
        yasnippet-snippets

        # code
        treesit-grammars.with-all-grammars
        nix-ts-mode
        markdown-mode
        just-mode
        dockerfile-mode
        web-mode
        eglot-booster
        apheleia # format on save
        envrc # direnv, per buffer
        dape # debugger

        # git
        magit
        diff-hl

        # editing and moving around
        avy
        ace-window
        expand-region
        multiple-cursors
        vundo
        helpful

        # writing, files, docs
        jinx # spell check (enchant + the hunspell dictionaries from documents.nix)
        org-modern
        org-appear
        olivetti
        pdf-tools
        vterm

        # housekeeping
        no-littering
        gcmh
      ];
  };

  # one Emacs in the background, started on first use (socket activation): `emacsclient -c`
  # opens a window in it instantly, and the "Emacs (Client)" launcher entry does the same.
  # $EDITOR stays nvim.
  services.emacs = {
    enable = true;
    client.enable = true;
    socketActivation.enable = true;
  };

  xdg.configFile = {
    "emacs/early-init.el".source = ./early-init.el;
    "emacs/init.el".source = ./init.el;
    "emacs/lisp/nix.el".source = nixEl;
  };
}
